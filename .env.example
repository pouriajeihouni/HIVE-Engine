# ══════════════════════════════════════════════════════════════════
# HIVE configuration — copy this file to `.env` and fill it in.
# Everything is optional: with no settings at all Hive runs in
# DEMO MODE (mock brain + demo-vault) so you can try it safely.
# ══════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────
# ═ Brain provider — two engines, pick with one line ═
#   groq      → GroqCloud (Llama 3.3 70B etc.) — FREE tier covers Hive's
#               whole workload (no credit card). Key: console.groq.com/keys
#   anthropic → Claude (smarter per token, pay-per-use)
# If BOTH keys are present, set LLM_PROVIDER explicitly.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Groq models on your account (2026 catalog): openai/gpt-oss-120b (default,
#   smartest) · qwen/qwen3.8-27b and qwen/qwen3.6-27b (capable, separate rate
#   budget) · openai/gpt-oss-20b (fast/light). Whisper/orpheus are audio,
#   compound is a web-search agent — Hive never picks those.
# If a model id is ever retired on your account, Hive auto-switches to the
# best available model and logs the name — paste that name here to pin it.
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic engine (optional — your second brain can switch anytime)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Your Obsidian vault folder (the folder that contains .obsidian/)
OBSIDIAN_VAULT_PATH=/Users/pouria/Documents/Obsidian

AGENT_NAME=Hive
USER_NAME=Pouria

# ── Timing ────────────────────────────────────────────────────────
# How often the AI "brain" thinks (minutes, min 5, max 1440).
# Timers/alarms/reminders still fire on a fast tick regardless.
BRAIN_INTERVAL_MINUTES=60
TICK_SECONDS=15

# Scheduled jobs (24h HH:MM, local time)
DAILY_BRIEF_TIME=07:00        # every day
WEEKLY_PLAN_TIME=08:00        # Mondays
WEEKLY_SUMMARY_TIME=16:00     # Fridays
HS_CHECKLIST_TIME=09:00       # Fridays — TPH Health & Safety nudge

# ── Calendar ───────────────────────────────────────────────────────
# auto   = Google (if authorized) → Apple Calendar → local file (default)
# apple  = Calendar.app only — ZERO setup on macOS; sees every calendar
#          synced into Calendar.app (iCloud + Google accounts added to Mac)
# google = Google Calendar API only (needs credentials + google-auth)
# local  = data/calendar.json only
# Since your Apple Calendar is synced with Google, any source sees the
# same events — apple is the simplest choice on a Mac.
CALENDAR_SOURCE=auto

# ── Google Calendar + Gmail (optional) ────────────────────────────
# See docs/GOOGLE_SETUP.md for the walkthrough.
GOOGLE_CREDENTIALS=./credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ENABLED=true
GMAIL_ENABLED=true
GOOGLE_MAX_EVENTS=25

# ── Safety & behaviour ────────────────────────────────────────────
# Email drafts ALWAYS require approval. This flag additionally gates
# whether the approve CLI is even allowed to hit Gmail's send API.
# Keep false unless you really want Hive able to send.
ALLOW_EMAIL_SEND=false

# ── Resilience (automatic — docs/BACKUP_AND_RESTORE.md) ──────────
# Nightly vault backup + log hygiene + heartbeat. Zero AI cost.
BACKUP_TIME=23:30
BACKUP_DIR=~/Documents/HIVE-Backups

NOTIFICATIONS=true
NOTIFICATION_SOUND=true

MAX_TOKENS=2400
MAX_CONTEXT_CHARS=8000

# ── Cloud engine (Render / any host) — docs/CLOUD_ENGINE.md ──────
# The server auto-enables when the host provides PORT (Render does).
# REQUIRED to serve: a long random key — openssl rand -hex 16
# WEB_AUTH_KEY=
# UPLOAD_MAX_MB=25
# FILE_CONTEXT_CHARS=12000

# ── Phone: Telegram two-way chat — npm run telegram-setup ────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web dashboard relay (Mac mode) — docs/WEB_DASHBOARD.md ───────
WEB_RELAY_PIN=
WEB_RELAY_TOKEN=
# WEB_PUBLISH_DIR=
